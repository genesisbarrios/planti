# Planti environment variables. Copy to .env.local and fill in.
# Never commit .env.local. Only NEXT_PUBLIC_* values are sent to the browser.

# --- Supabase (Project Settings -> API in the Supabase dashboard) ---
# Project URL, e.g. https://abcd1234.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key. SERVER ONLY. Used solely by device telemetry
# ingestion after the device credential has been verified.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, used ONLY by the Supabase CLI to apply
# migrations (never read by the app). Supabase -> Connect -> Session pooler,
# with your database password filled in.
SUPABASE_DB_URL=

# --- Nebius Token Factory (https://tokenfactory.nebius.com -> API keys) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# An NVIDIA Nemotron model ID copied from the current Token Factory catalog.
NEBIUS_MODEL=

# --- Tavily (https://app.tavily.com -> API keys) ---
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# --- Device ingestion ---
# Server-side pepper for hashing per-device credentials (HMAC-SHA256).
# Generate with: openssl rand -hex 32
DEVICE_INGESTION_SECRET=
# A device is shown as online only if it reported within this many minutes.
DEVICE_ONLINE_THRESHOLD_MINUTES=15

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
